NODE_ENV="development"
METRICS_TOKEN=
SUBTITLE_RESULT_LIMIT=
HOST=
GROQ_API_KEY=
GROQ_MODEL=
# Optional generic OpenAI-compatible provider (OpenRouter, NVIDIA NIM, Cerebras, ...)
# to add free model sources to the rotation pool. Leave empty to use Groq only.
#
# NVIDIA NIM example (large models stream slowly; the app streams so they don't time out):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
#   LLM_API_KEY=nvapi-...
#   LLM_MODELS=deepseek-ai/deepseek-v4-flash-0731,minimaxai/minimax-m3,nvidia/nemotron-3-super-120b-a12b,z-ai/glm-5.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELS=
# Streaming/timeout tuning (milliseconds). Large hosted models have long time-to-first-token;
# streaming keeps the connection alive. Idle = max gap between tokens; Total = hard ceiling.
LLM_IDLE_TIMEOUT_MS=60000
LLM_TOTAL_TIMEOUT_MS=180000
# Per-model probe timeout for the "Check models" dashboard (time to first token).
PROBE_TIMEOUT_MS=20000
GENERATED_SUBTITLE_CACHE_TTL_SECONDS=