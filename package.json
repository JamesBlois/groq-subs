{
	"name": "groq-subs",
	"version": "1.0.0",
	"description": "Double subtitles for Stremio powered by Groq",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --fix",
		"prepare": "husky || true",
		"start": "node --watch --watch-path=server.js --watch-path=addon.js --watch-path=subtitle-service.js --watch-path=lib --watch-path=web server.js",
		"test": "mocha"
	},
	"dependencies": {
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"lru-cache": "^10.4.3",
		"prom-client": "^15.1.3",
		"redis": "^6.0.0",
		"stremio-addon-sdk": "1.1.x",
		"subtitle": "^4.2.2"
	},
	"pnpm": {
		"overrides": {
			"router@1>path-to-regexp": "0.1.13",
			"external-editor>tmp": "^0.2.6",
			"mocha>serialize-javascript": "^7.0.5",
			"mocha>diff": "^8.0.3"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.0",
		"husky": "^9.0.11",
		"mocha": "^11.7.6",
		"prettier": "^3.8.3"
	}
}